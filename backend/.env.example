# Copy to backend/.env for running the backend natively (uv run …). Never commit .env.
# Inside docker compose, hostnames are overridden in compose.yaml (postgres, redis).

# local | test | staging | production — required, the app refuses to start without it
ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://uzsenpai:uzsenpai@localhost:5432/uzsenpai
TEST_DATABASE_URL=postgresql+asyncpg://uzsenpai:uzsenpai@localhost:5432/uzsenpai_test

# Redis DB indexes: 0 = app, 1 = Taskiq broker (2 = bot FSM, set in bot/.env)
REDIS_URL=redis://localhost:6379/0
TASKIQ_BROKER_URL=redis://localhost:6379/1

# JSON list
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_WEB_URL=http://localhost:5173

# Auth (ADR 0007). Local dev works with built-in defaults; staging/production refuse to start without strong values.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# BOT_SERVICE_TOKEN=
# From @BotFather; verifies Telegram Login Widget data
# TELEGRAM_BOT_TOKEN=
# false only for plain-http local development
REFRESH_COOKIE_SECURE=false

# Behind Caddy (ADR 0006): uvicorn trusts X-Forwarded-For only from these addresses. Set it to the proxy's
# exact IP/network — never "*" while port 8000 is reachable directly — or every client looks like the proxy
# and per-IP rate limits become one shared bucket.
# FORWARDED_ALLOW_IPS=172.18.0.2
